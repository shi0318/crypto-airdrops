---
import ListingPage from '../../components/ListingPage.astro';
import { IMPORT_META } from '../../data/airdrops';

export function getStaticPaths() {
  const totalPages = Math.ceil(IMPORT_META.total / 24);
  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  });
}

const { page } = Astro.props;
---
<ListingPage page={page} path={`/page/${page}/`} />
